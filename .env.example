NODE_ENV=development
PORT=3002

# เธเธฒเธเธเนเธญเธกเธนเธฅเธเธญเธ subsystem เธเธตเนเน€เธ—เนเธฒเธเธฑเนเธ - เธซเนเธฒเธกเธเธตเนเนเธเธ—เธตเน core_hub
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/change_me_db

# Core Hub (เธเธนเนเนเธซเน identity)
CORE_HUB_URL=https://csmju2030.jowave.com
CORE_HUB_JWKS_URL=https://csmju2030.jowave.com/api/v1/.well-known/jwks.json

# เธชเธฑเธเธเธฒเธ—เธตเนเธ•เธฃเธถเธเนเธงเน - เธซเนเธฒเธกเน€เธเธฅเธตเนเธขเธเธเนเธฒเน€เธซเธฅเนเธฒเธเธตเนเน€เธญเธ
CORE_HUB_ISSUER=core-hub
