APP_NAME=software-project-risk-api
NODE_ENV=development
PORT=4201
SUBSYSTEM_ID=software-project-risk
SUBSYSTEM_NAME=Software Project Risk

# Subsystem-owned PostgreSQL database. Never point this at Core Hub DB.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/software_project_risk"

# CSMJU2030 Core Hub integration
CORE_HUB_URL=https://csmju2030.jowave.com
CORE_HUB_JWKS_URL=https://csmju2030.jowave.com/api/v1/.well-known/jwks.json
CORE_HUB_ISSUER=core-hub
CORE_HUB_AUDIENCE=csmju2030

JWKS_CACHE_TTL_MS=600000
JWKS_MIN_REFRESH_INTERVAL_MS=30000
JWKS_REQUEST_TIMEOUT_MS=5000
JWT_CLOCK_TOLERANCE_SEC=5
CORE_HUB_DATA_CACHE_TTL_MS=600000
CORE_HUB_DATA_MIN_REFRESH_INTERVAL_MS=30000
CORE_HUB_DATA_REQUEST_TIMEOUT_MS=5000
CORE_HUB_WEB_URL=https://csmju2030.jowave.com
